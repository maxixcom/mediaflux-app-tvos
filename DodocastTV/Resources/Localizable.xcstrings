{
  "sourceLanguage": "ru",
  "strings": {
    "Аккаунт ещё не готов: один раз откройте личный кабинет в браузере и войдите.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account isn't ready yet: open your personal account in a browser and sign in once."
          }
